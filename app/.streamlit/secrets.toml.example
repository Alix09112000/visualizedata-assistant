# Copiez ce fichier en .streamlit/secrets.toml (jamais commité) — ou renseignez
# les mêmes valeurs dans Render > Environment > Secret Files.

[auth]
redirect_uri = "https://visualizedata-assistant.onrender.com/oauth2callback"
cookie_secret = "CHAINE_ALEATOIRE_LONGUE_ET_SECRETE"

[auth.google]
client_id = "VOTRE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "VOTRE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
